<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Lidarr.Plugin.YandexMusicMetadata</RootNamespace>
    <AssemblyName>Lidarr.Plugin.YandexMusic.Metadata</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Yandex Music and Deezer metadata sources plus Yandex Music and Deezer playlist import lists for Lidarr.</Description>
    <MinimumLidarrVersion>3.1.3.0</MinimumLidarrVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <Version>1.0.2</Version>
    <InformationalVersion>1.0.2</InformationalVersion>
  </PropertyGroup>

  <!--
    Match the working Yandex.Music indexer/downloader project:
    compile against Lidarr's plugins branch as a project reference.
    The build scripts pin AssemblyVersion/FileVersion to 1.0.0 globally,
    which is critical: otherwise Lidarr.Core type refs become 10.0.0.*
    and the plugin cannot load in the Hotio/plugin host.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\ext\Lidarr\src\NzbDrone.Core\Lidarr.Core.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
